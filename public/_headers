# Security headers for hosts that support them — Cloudflare Pages and Netlify
# both read this file. GitHub Pages ignores it entirely and cannot serve custom
# headers at all, which is the main reason to move the custom domain to one of
# those two rather than pointing cafefaim.nl at GitHub Pages.
#
# Everything here that CAN be expressed as a <meta> tag already is, generated by
# scripts/seo.mjs, so the site is not defenceless until then. These are the ones
# a meta tag cannot express: frame-ancestors, HSTS, nosniff, Permissions-Policy.

/*
  # Clickjacking. frame-ancestors is the modern form and is ignored in a meta
  # tag, so it only takes effect once real headers are served.
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

  # Stop the browser guessing a content type — the classic way an uploaded
  # "image" gets executed as script.
  X-Content-Type-Options: nosniff

  # Send the full URL only to ourselves; other origins see the origin alone.
  Referrer-Policy: strict-origin-when-cross-origin

  # The site needs none of these, so deny them outright rather than leaving the
  # decision to a future dependency.
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # Two years, subdomains included, preload-eligible. Only enable preload once
  # you are certain every subdomain can serve HTTPS — it is hard to undo.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off

# Hashed filenames, so these can be cached indefinitely and safely.
/assets/build/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and the hero video keep their names across deploys, so they get a long
# cache with revalidation rather than immutable.
/assets/gallery/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The dashboard: never cached, never indexed, never framed. The header is what
# actually keeps it out of search results — robots.txt only asks politely, and
# a Disallow line is itself a signpost saying "something is here".
/fata
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store
/fata.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store

# HTML is small and changes on every deploy; revalidate rather than serve stale.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
