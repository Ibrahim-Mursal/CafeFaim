# Copy to .env and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Both values are safe to ship in the browser bundle. The anon key identifies
# the project; it does not grant permission. What a request may actually do is
# decided by the Row Level Security policies in supabase/schema.sql.
#
# NEVER put the service_role key here, or in any variable starting with VITE_.
# It bypasses RLS entirely, and everything VITE_ prefixed is compiled into
# files any visitor can download.
#
# .env is gitignored. Set these as environment variables in your host's build
# settings too, or the deployed build will fall back to the bundled content.

VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
